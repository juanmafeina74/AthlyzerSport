generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProtocoloAntropometrico {
  BASICA
  ISAK
}

model rol {
  id_rol   Int      @id @default(autoincrement())
  nombre   String   @unique @db.VarChar(50)
  usuarios usuario[]
}

model usuario {
  id_usuario               Int                       @id @default(autoincrement())
  nombre                   String                    @db.VarChar(100)
  email                    String                    @unique @db.VarChar(150)
  password_hash            String                    @db.VarChar(255)
  id_rol                   Int
  activo                   Boolean                   @default(true)
  rol                      rol                       @relation(fields: [id_rol], references: [id_rol])
  mediciones_antropometricas medicion_antropometrica[]
}

model equipo {
  id_equipo      Int              @id @default(autoincrement())
  id_temporada   Int
  id_categoria   Int?
  nombre         String           @db.VarChar(100)
  fecha_creacion DateTime         @db.Date
  protocolo_antropometrico ProtocoloAntropometrico @default(BASICA)
  version_protocolo_antropometrico Int @default(1)
  temporada      temporada        @relation(fields: [id_temporada], references: [id_temporada], onDelete: Restrict)
  categoria      categoria?       @relation(fields: [id_categoria], references: [id_categoria], onDelete: Restrict)
  jugador_equipo jugador_equipo[]
  mediciones_antropometricas medicion_antropometrica[]

  @@index([id_categoria], map: "idx_equipo_categoria")
  @@index([id_temporada], map: "idx_equipo_temporada")
}

model categoria {
  id_categoria Int      @id @default(autoincrement())
  nombre       String   @unique @db.VarChar(50)
  activo       Boolean  @default(true)
  equipos      equipo[]
}

model jugador {
  id_jugador              Int                       @id @default(autoincrement())
  dni                     String                    @unique @db.VarChar(20)
  nombre                  String                    @db.VarChar(100)
  apellidos               String                    @db.VarChar(150)
  fecha_nacimiento        DateTime                  @db.Date
  foto                    String?
  jugador_equipo          jugador_equipo[]
  lesion                  lesion[]
  medicion_antropometrica medicion_antropometrica[]

  @@index([nombre, apellidos], map: "idx_jugador_nombre")
}

model jugador_equipo {
  id_jugador_equipo Int       @id @default(autoincrement())
  id_jugador        Int
  id_equipo         Int
  fecha_inicio      DateTime  @db.Date
  fecha_fin         DateTime? @db.Date
  dorsal            Int?
  activo            Boolean   @default(true)
  equipo            equipo    @relation(fields: [id_equipo], references: [id_equipo], onDelete: Cascade)
  jugador           jugador   @relation(fields: [id_jugador], references: [id_jugador], onDelete: Cascade)

  @@index([activo], map: "idx_jugador_equipo_activo")
  @@index([id_equipo], map: "idx_jugador_equipo_equipo")
  @@index([id_jugador], map: "idx_jugador_equipo_jugador")
}

model lesion {
  id_lesion     Int       @id @default(autoincrement())
  id_jugador    Int
  fecha_inicio  DateTime  @db.Date
  fecha_fin     DateTime? @db.Date
  tipo_lesion   String?   @db.VarChar(100)
  zona_corporal String?   @db.VarChar(100)
  fase_readaptacion String @default("Fase 1") @db.VarChar(30)
  fecha_alta_real DateTime? @db.Date
  gravedad      String?   @db.VarChar(50)
  alta_medica   Boolean   @default(false)
  observaciones String?
  jugador       jugador   @relation(fields: [id_jugador], references: [id_jugador], onDelete: Cascade)

  @@index([id_jugador], map: "idx_lesion_jugador")
  @@index([tipo_lesion], map: "idx_lesion_tipo")
}

model medicion_antropometrica {
  id_medicion                    Int      @id @default(autoincrement())
  id_jugador                     Int
  id_evaluador                   Int
  id_equipo                      Int?
  protocolo                      ProtocoloAntropometrico
  fecha                          DateTime @default(now())
  peso_kg                        Float
  talla_cm                       Float
  talla_sentado_cm               Float?
  pliegue_tricipital             Float?
  pliegue_subescapular           Float?
  pliegue_supraespinal           Float?
  pliegue_abdominal              Float?
  pliegue_muslo                  Float?
  pliegue_pantorrilla            Float?
  pliegue_bicipital              Float?
  pliegue_cresta_iliaca          Float?
  perimetro_brazo_relajado       Float?
  perimetro_brazo_flexionado     Float?
  perimetro_cintura              Float?
  perimetro_cadera               Float?
  perimetro_muslo_medio          Float?
  perimetro_pantorrilla          Float?
  diametro_biepicondilar_humero  Float?
  diametro_biepicondilar_femur   Float?
  diametro_biestiloideo          Float?
  sumatoria_6_pliegues           Float?
  sumatoria_8_pliegues           Float?
  porcentaje_grasa               Float?
  porcentaje_musculo             Float?
  somatotipo_endomorfia          Float?
  somatotipo_mesomorfia          Float?
  somatotipo_ectomorfia          Float?
  somatocarta_x                  Float?
  somatocarta_y                  Float?
  observaciones                  String?  @db.Text
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt
  jugador                        jugador  @relation(fields: [id_jugador], references: [id_jugador], onDelete: Cascade)
  evaluador                      usuario  @relation(fields: [id_evaluador], references: [id_usuario])
  equipo                         equipo?  @relation(fields: [id_equipo], references: [id_equipo], onDelete: Restrict)

  @@index([fecha], map: "idx_medicion_fecha")
  @@index([id_equipo], map: "idx_medicion_equipo")
  @@index([id_evaluador], map: "idx_medicion_evaluador")
  @@index([id_jugador], map: "idx_medicion_jugador")
  @@map("medicion_antropometrica")
}

model posicion {
  id_posicion Int     @id @default(autoincrement())
  nombre      String  @db.VarChar(100)
  abreviatura String? @db.VarChar(10)
}

model temporada {
  id_temporada Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(100)
  fecha_inicio DateTime @db.Date
  fecha_fin    DateTime @db.Date
  estado       String   @db.VarChar(50)
  equipo       equipo[]

  @@index([estado], map: "idx_temporada_estado")
}
